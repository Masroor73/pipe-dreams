# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
*.egg-info/

# Node / frontend
node_modules/
frontend/dist/
*.log

# Secrets
.env

# Raw data downloads (fetch via scripts; never commit)
data/*
!data/.gitkeep

# Real artifacts are regenerated by the engine; synthetic fixtures are committed
artifacts/*
!artifacts/.gitkeep
!artifacts/synthetic/
artifacts/synthetic/*
!artifacts/synthetic/.gitkeep
!artifacts/synthetic/**

# OS / editor
.DS_Store
Thumbs.db
.vscode/
.idea/
.env.local
*.local
